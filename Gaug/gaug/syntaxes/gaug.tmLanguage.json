{
    "name": "Gaug",
    "scopeName": "source.gaug",
    "patterns": [
        {
            "name": "string.quoted.double.gaug",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.gaug",
                    "match": "\\\\."
                }
            ]
        },
        {
            "name": "string.quoted.single.gaug",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.gaug",
                    "match": "\\\\."
                }
            ]
        },
        {
            "name": "storage.modifier",
            "match": "\\b(?:const|var)\\b"
        },
        {
            "name": "keyword.control",
            "match": "\\b(?:if|elseif|else|while|for|in|return)\\b"
        },
        {
            "name": "support.function",
            "match": "\\b(?:print|len|wait|math\\.(?:sqrt|abs|min|max)|list\\.(?:new|push|get)|gc\\.(?:enable|disable|collect|count|setthreshold|getthreshold)|dict\\.(?:has|keys)|http\\.(?:get|post|request)|json\\.(?:parse|stringify)|task\\.(?:await|done))\\b(?=\\s*\\()"
        },
        {
            "name": "entity.name.function",
            "match": "\\b[A-Za-z_]\\w*\\b(?=\\s*\\()"
        },
        {
            "name": "support.constant",
            "match": "\\b(?:math\\.inf|math\\.pi)\\b"
        },
        {
    "match": "\\b(type)\\b(\\s+)(new|modify)\\b",
    "captures": {
        "1": {
            "name": "keyword.control.type.gaug"
        },
        "3": {
            "name": "storage.modifier.type.gaug"
        }
    }
        },
        {
            "name": "constant.language.boolean",
            "match": "\\b(true|false)\\b"
        },
        {
            "begin": "(>>>)\\s*",
            "beginCaptures": {
                "1": {
                    "name": "keyword.operator.type.gaug"
                }
            },
            "end": "(?=\\s*[=;)(,\\n\"'{}\\[\\]]|$)",
            "patterns": [
                {
                    "name": "entity.name.type.gaug",
                    "match": "\\b[A-Za-z_]\\w*\\b"
                }
            ]
        },
        {
            "match": "\\b[A-Za-z_]\\w*(?=\\s*:\\s*[A-Za-z_]\\w*)",
            "captures": {
                "0": {
                    "name": "variable.parameter"
                }
            }
        },
        {
            "name": "punctuation.accessor.dictionary.gaug",
            "match": "(?<=\\w)<|>(?=\\s*(?:[\"']|\\d|[A-Za-z_]))"
        },
        {
            "name": "keyword.operator",
            "match": "->|\\+=|==|!=|<=|>=|=|[+*/<>-]"
        }
    ]
}